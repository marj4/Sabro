---
import Header from '../components/Header.astro';
import BookButton from '../components/BookButton.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import '../styles/global.css';
import '../../public/map.css';
import ResponsiveImage from '../components/ResponsiveImage.astro';

const maps = 'https://yandex.ru/maps/org/sabr/162425003228/';
const whatsapp = 'https://wa.me/79894511717';
const gallery = [
  { number: '02', title: 'Пространство Sabr', description: 'Общий план зала: кресла, зеркала и свет. Горизонтальный кадр.', size: '1600 × 1200', class: 'photo--room' },
  { number: '03', title: 'Внимание к деталям', description: 'Инструменты мастера и детали рабочего места крупным планом.', size: '1200 × 1500', class: 'photo--detail', image: '/images/gallery/tools.webp' },
  { number: '04', title: 'В руках мастера', description: 'Живой кадр процесса стрижки — руки, движение, концентрация.', size: '1200 × 1500', class: 'photo--work', video: '/videos/barber-work-optimized.mp4' },
  { number: '05', title: 'Готовый образ', description: 'Портрет гостя после стрижки. Нейтральный фон и естественный свет.', size: '1600 × 1200', class: 'photo--result', image: '/images/gallery/finished-look.webp' },
];
const services = [
  ['Стрижка головы и бороды', '1800 ₽'],
  ['Стрижка головы', '1000 ₽'],
  ['Стрижка сантиметровка', '600 ₽'],
  ['Стрижка бороды', '700 ₽'],
  ['Детская стрижка', '700 ₽'],
  ['Детская сантиметровка', '500 ₽'],
  ['Стрижка удлинённых волос ножницами', '1500 ₽'],
  ['Стрижка под ноль', '400 ₽'],
  ['Стрижка головы по краевой', '600 ₽'],
  ['Окантовка головы', '400 ₽'],
  ['Окантовка бороды', '400 ₽'],
  ['Депиляция щёк воском', '300 ₽'],
  ['Депиляция носа воском', '200 ₽'],
  ['Депиляция ушей воском', '200 ₽'],
  ['Закрашивание волос головы', '800 ₽'],
  ['Закрашивание волос бороды', '700 ₽'],
  ['Чистка лица · чёрная маска', '1000 ₽'],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sabr — барбершоп в Махачкале</title>
    <meta name="description" content="Sabr — барбершоп в Махачкале. Проспект Али-Гаджи Акушинского, 301. Ежедневно с 10:00 до 20:00. Запись: +7 (989) 451-17-17." />
    <meta name="theme-color" content="#171714" />
    <meta property="og:title" content="Sabr — барбершоп в Махачкале" />
    <meta property="og:description" content="Стрижка. Детали. Твой характер. Ежедневно 10:00–20:00, просп. Али-Гаджи Акушинского, 301." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <section id="top" class="hero" aria-labelledby="hero-title">
      <div class="hero__backdrop intro-glow" aria-hidden="true"></div>
      <Header />
      <div class="hero__photo-note intro-late" style="--i:0"><span class="status-dot"></span>Место для фото / панорама интерьера Sabr <span>1920 × 1280</span></div>
      <div class="hero__center">
        <p class="eyebrow intro-late" style="--i:0">Твой барбершоп в Махачкале</p>
        <h1 id="hero-title" class="intro-title">SABR</h1>
        <div class="hero__tagline"><span class="intro-late" style="--i:1">Стрижка. Детали. Твой характер.</span><span class="intro-late hero__book-reveal" style="--i:2"><BookButton href={whatsapp} label="Записаться" /></span></div>
      </div>
      <div class="hero__bottom"><a class="interactive-line intro-late" style="--i:3" href={maps} target="_blank" rel="noopener noreferrer">Махачкала<br />просп. Али-Гаджи Акушинского, 301</a><a href="tel:+79894511717" class="hero__telephone interactive-line intro-late" style="--i:4">+7 (989) 451-17-17<span>Ежедневно / 10:00–20:00</span></a></div>
      <div class="ticker intro-late" style="--i:5">
        <div class="ticker__track" aria-hidden="true">
          {[0, 1].map(() => <div class="ticker__group">{['BARBERSHOP', 'МАХАЧКАЛА', 'SABR', 'СТРИЖКА. ДЕТАЛИ. ХАРАКТЕР.', 'BARBERSHOP', 'МАХАЧКАЛА', 'SABR', 'СТРИЖКА. ДЕТАЛИ. ХАРАКТЕР.'].map(text => <span>{text}<i>/</i></span>)}</div>)}
        </div>
      </div>
    </section>
    <main id="main">
      <section id="about" class="about section shell" aria-labelledby="about-title">
        <div class="section-label"><span>01 / Знакомство</span><span>Махачкала, Дагестан</span></div>
        <div class="about__layout">
          <div class="about__visual">
            <figure class="about__portrait about__portrait--main"><ResponsiveImage src="/images/barber/master-02.webp" alt="Барбер Sabr во время работы с клиентом" sizes="(max-width: 700px) 72vw, 36vw" /></figure>
            <figure class="about__portrait about__portrait--small"><ResponsiveImage src="/images/barber/master-03.webp" alt="Барбер Sabr выполняет стрижку ножницами" sizes="(max-width: 700px) 40vw, 20vw" /></figure>
          </div>
          <div class="about__copy">
            <h2 id="about-title">Меня зовут<br /><em>[имя]</em></h2>
            <p>Меня зовут мастер Sabr. Я стригу людей уже 20 лет и понимаю, как важно не просто повторить стрижку, а услышать, чего именно вы хотите.</p>
            <p>За плечами — опыт работы в Avenue и сотни разных образов. Подбираю форму внимательно, работаю в рамках дозволенного и всегда объясняю, каким получится результат.</p>
            <BookButton href={whatsapp} label="На связи в WhatsApp" />
          </div>
        </div>
        <div class="about__services">
          <div class="about__services-heading"><span>Услуги</span><span>Прайс-лист Sabr</span></div>
          <div class="about__services-list">{services.map(([name, price]) => <div class="service-row"><span>{name}</span><strong>{price}</strong></div>)}</div>
        </div>
      </section>
      <section id="gallery" class="gallery section shell" aria-labelledby="gallery-title">
        <div class="section-label"><span>02 / Внутри Sabr</span><span>Пространство и люди</span></div>
        <div class="section-heading"><h2 id="gallery-title">Всё дело<br />в <em>деталях.</em></h2><p>Место, в которое возвращаются.<br />Люди, которым доверяют свой стиль.</p></div>
        <div class="gallery__grid">{gallery.map(photo => <PhotoPlaceholder {...photo} />)}</div>
        <div class="gallery__footer"><span>Здесь появятся фотографии Sabr</span></div>
      </section>
      <section id="contacts" class="contacts section shell" aria-labelledby="contacts-title">
        <div class="section-label"><span>03 / До встречи</span><span>Каждый день, 10:00–20:00</span></div>
        <div class="contacts__layout"><div class="contacts__info"><h2 id="contacts-title">Увидимся<br />в <em>Sabr.</em></h2><p class="contacts__intro">Выбери время. Всё остальное<br />начинается в кресле мастера.</p><BookButton href={whatsapp} label="Записаться в WhatsApp" class="contacts__book" /><dl><div><dt>Где мы</dt><dd>Махачкала,<br />просп. Али-Гаджи Акушинского, 301</dd></div><div><dt>Когда</dt><dd>Ежедневно, 10:00–20:00</dd></div><div><dt>Позвонить</dt><dd><a class="interactive-line" href="tel:+79894511717">+7 (989) 451-17-17</a></dd></div></dl><p class="schedule-note">В праздничные дни график может меняться. Уточните время по телефону.</p><div class="socials"><a class="btn-book contact-social" href="https://www.instagram.com/barbershop_sabr_/" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg><span class="btn-book__text">Instagram</span><span aria-hidden="true">↗</span></a><a class="btn-book contact-social" href={maps} target="_blank" rel="noopener noreferrer"><span class="btn-book__text">Построить маршрут</span><span aria-hidden="true">↗</span></a></div></div><div class="contacts__visual"><div class="sabr-map-card"><div class="sabr-map-card__fallback"><img src="/images/gallery/location-map.webp" alt="Карта расположения SABR" loading="lazy" decoding="async" width="537" height="447" /><div class="sabr-map-card__fallback-content"><strong>SABR</strong><span>Махачкала, просп. Али-Гаджи Акушинского, 301</span><a href={maps} target="_blank" rel="noopener noreferrer">Открыть в Яндекс Картах ↗</a></div></div></div></div></div>
      </section>
      <section id="reviews" class="reviews section shell" aria-labelledby="reviews-title">
        <div class="section-label"><span>04 / Отзывы</span><span>Слово гостям</span></div>
        <div class="section-heading"><h2 id="reviews-title">Хорошая стрижка.<br /><em>Хорошие слова.</em></h2><div class="rating"><span>4,3<span aria-hidden="true">★</span></span><p>21 оценка на Яндекс Картах</p></div></div>
        <div class="reviews__toolbar"><div class="review-tabs"><span>Все отзывы</span><a class="interactive-line" href={`${maps}reviews/`} target="_blank" rel="noopener noreferrer"><b aria-hidden="true">Я</b> Яндекс · 4,3 ↗</a></div><a class="button button--small interactive-line" href={`${maps}reviews/`} target="_blank" rel="noopener noreferrer">Оставить отзыв ↗</a></div>
        <p class="reviews__count">10 отзывов на Яндекс Картах</p>
        <div class="reviews__grid">{Array.from({length: 3}, (_, i) => <article class="review-card"><div class="review-card__top"><span class="review-card__number">0{i + 1}</span><span>Отзыв гостя<small>Место для подтверждённого отзыва</small></span></div><span class="review-card__quote" aria-hidden="true">“</span><p>Здесь появится отзыв гостя Sabr. Имя, дата и оценка будут добавлены вместе с оригинальным текстом.</p><a href={`${maps}reviews/`} target="_blank" rel="noopener noreferrer">Читать отзывы на Яндексе <span aria-hidden="true">↗</span></a></article>)}</div>
      </section>
    </main>
    <footer class="footer shell"><div class="footer__top"><a href="#top" class="logo" aria-label="Sabr — наверх">SABR</a><p>Твой барбершоп. Твой характер.</p><a href="#top" class="text-link interactive-line">Наверх ↑</a></div><div class="footer__bottom"><span>© {new Date().getFullYear()} Sabr</span><span>Махачкала / 10:00–20:00</span><a class="interactive-line" href="tel:+79894511717">+7 (989) 451-17-17</a></div></footer>
  </body>
</html>
