---
interface Props {
  number: string;
  title: string;
  description: string;
  size: string;
  class?: string;
  image?: string;
  video?: string;
}
const { number, title, description, size, class: className, image, video } = Astro.props;
---
<figure class:list={['photo', className, { 'photo--has-media': image || video }]} aria-label={`Место для фото: ${title}. ${description}`}>
  {image && <img class="photo__media" src={image} alt={title} />}
  {video && <video class="photo__media photo__video" autoplay muted loop playsinline preload="metadata" aria-label={title}><source src={video} type="video/mp4" /></video>}
  <div class="photo__top" aria-hidden="true"><span>Фото / {number}</span><span>{size}</span></div>
  <svg class="photo__symbol" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M16 8H8v8m40-8h8v8M8 48v8h8m40-8v8h-8M22 32h20M32 22v20" stroke="currentColor" stroke-width="1"/></svg>
  <figcaption><strong>{title}</strong><span>{description}</span></figcaption>
</figure>
