---
import '../styles/book-button.css';
interface Props { href: string; label: string; class?: string; style?: string; }
const { href, label, class: className, style } = Astro.props;
---
<a class:list={['btn-book', className]} href={href} target="_blank" rel="noopener noreferrer" style={style}>
  <span class="btn-book__text">{label}</span>
  <svg class="btn-book__arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
