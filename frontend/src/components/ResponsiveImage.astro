---
import variants from '../data/image-variants.json';
interface Props { src: string; alt: string; class?: string; sizes?: string; }
const { src, alt, class: className, sizes = '(max-width: 700px) calc(100vw - 48px), 40vw' } = Astro.props;
const image = variants[src as keyof typeof variants];
const fallback = image?.sources.at(-1)?.url ?? src;
---
<img class={className} src={fallback} srcset={image?.sources.map(source => `${source.url} ${source.width}w`).join(', ')} sizes={image ? sizes : undefined} width={image?.width} height={image?.height} alt={alt} loading="lazy" decoding="async" />
