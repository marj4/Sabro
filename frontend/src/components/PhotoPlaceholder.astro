---
import ResponsiveImage from './ResponsiveImage.astro';
import { embeddedImages } from '../data/embedded-images';
interface Props {
  number: string;
  title: string;
  description: string;
  size: string;
  class?: string;
  image?: string;
  video?: string;
}
const { number, title, description, size, class: className, image, video } = Astro.props;
---
<figure class:list={['photo', className, { 'photo--has-media': image || video }]} aria-label={`Место для фото: ${title}. ${description}`}>
  {image && <ResponsiveImage class="photo__media" src={image} alt={title} />}
  {video && <video class="photo__media photo__video" data-lazy-video src={video} poster={embeddedImages['/images/gallery/barber-work-poster.webp']} muted loop playsinline preload="none" aria-label={title}></video>}
  <div class="photo__top" aria-hidden="true"><span>Фото / {number}</span><span>{size}</span></div>
  <svg class="photo__symbol" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M16 8H8v8m40-8h8v8M8 48v8h8m40-8v8h-8M22 32h20M32 22v20" stroke="currentColor" stroke-width="1"/></svg>
  <figcaption><strong>{title}</strong><span>{description}</span></figcaption>
</figure>
<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const manualPlayback = reducedMotion || connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? '');
  const setupVideo = (video: HTMLVideoElement) => {
    if (!video.dataset.loaded) {
      video.dataset.loaded = 'true';
      video.preload = 'auto';
      video.load();
    }
    if (!manualPlayback) video.play().catch(() => {});
  };
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) setupVideo(video);
        else video.pause();
      });
    }, { rootMargin: '150px' });
    videos.forEach(video => observer.observe(video));
  } else {
    videos.forEach(setupVideo);
  }
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) videos.forEach(video => video.pause());
  });
</script>
